{
  "name": "webtrace",
  "version": "0.1.0",
  "type": "module",
  "description": "Web performance trace collector — CDP-based data ingestion for performance diagnostics",
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ],
  "bin": {
    "webtrace": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
