{
	"name": "perfgraph",
	"version": "0.1.2",
	"type": "module",
	"description": "CDP-powered perf CLI — causal degradation graphs, not just Lighthouse scores",
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/",
		"skills/",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"perfgraph": "dist/index.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Be1zebub/PerfGraph.git"
	},
	"bugs": {
		"url": "https://github.com/Be1zebub/PerfGraph/issues"
	},
	"homepage": "https://github.com/Be1zebub/PerfGraph#readme",
	"keywords": [
		"web-performance",
		"lighthouse",
		"cdp",
		"core-web-vitals",
		"lcp",
		"cls",
		"performance",
		"profiler",
		"diagnostics"
	],
	"scripts": {
		"build": "npm run clean:dist && tsc",
		"clean:dist": "node scripts/clean-dist.mjs",
		"dev": "tsx watch src/index.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"setup:browser": "playwright install chromium",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@dagrejs/graphlib": "^4.0.1",
		"@toon-format/toon": "^2.3.1",
		"chrome-launcher": "^1.2.1",
		"lighthouse": "^13.3.0",
		"ow": "^3.1.0",
		"playwright": "^1.58.0",
		"zod": "^4.4.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"devtools-protocol": "^0.0.1638241",
		"tsx": "^4.20.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
