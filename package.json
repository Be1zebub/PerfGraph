{
  "name": "@gmod.one/webtrace",
  "version": "0.1.0",
  "type": "module",
  "description": "CDP-powered perf CLI — causal degradation graphs, not just Lighthouse scores",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "webtrace": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Be1zebub/WebTracer.git"
  },
  "bugs": {
    "url": "https://github.com/Be1zebub/WebTracer/issues"
  },
  "homepage": "https://github.com/Be1zebub/WebTracer#readme",
  "keywords": [
    "web-performance",
    "lighthouse",
    "cdp",
    "core-web-vitals",
    "lcp",
    "cls",
    "mcp",
    "performance",
    "profiler",
    "diagnostics"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@dagrejs/graphlib": "^4.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@toon-format/toon": "^2.3.1",
    "lighthouse": "^13.3.0",
    "ow": "^3.1.0",
    "playwright": "^1.58.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "devtools-protocol": "^0.0.1638241",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
