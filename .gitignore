# Deny everything
*

# Git
!.gitignore
!.gitattributes

# npm package contents (what gets published)
!dist/
!README.md
!CHANGELOG.md
!LICENSE

# Source & config (needed to build/test)
!src/
!src/**
!test/
!test/**
!package.json
!package-lock.json
!tsconfig.json
!vitest.config.ts

# Repo docs & CI
!.github/
!.github/**
!AGENTS.md
!CONTRIBUTING.md
!assets/

# Project specifications
!spec/
!spec/**

# Agent skills
!skills/
!skills/**

# Build scripts
!scripts/
!scripts/**
